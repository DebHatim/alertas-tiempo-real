# Configuración general y de red
SERVER_IP=localhost
APP_CORS_ALLOWED_ORIGIN=http://localhost
VITE_API_URL=http://localhost:8080/api

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=cambie-este-valor

# Usuario de aplicacion de BD (sin privilegios root, solo sobre la BD "alertas")
DB_APP_USER=alertas_app
DB_APP_PASSWORD=cambie-este-valor-tambien

# Seguridad backend
APP_JWT_SECRET=cambie-este-valor-por-una-cadena-aleatoria-de-al-menos-32-caracteres
APP_SIMULADOR_ENABLED=true